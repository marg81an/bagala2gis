# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ваш_secret_или_service_role_ключ

# Пароль для входа в /admin (придумайте сложный)
ADMIN_PASSWORD=придумайте-пароль
# Любая длинная случайная строка
SESSION_SECRET=длинная-случайная-строка

# Telegram → @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=BagalaBot
# Любая строка из латиницы/цифр, защищает вебхук
TELEGRAM_WEBHOOK_SECRET=случайная_строка_без_пробелов

# Необязательно: адрес сайта (если не указан — определяется автоматически)
BASE_URL=
# Часовой пояс для дат в кабинете
TIMEZONE=Asia/Almaty
